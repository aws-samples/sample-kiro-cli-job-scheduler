FROM node:20-slim
WORKDIR /app
RUN npm i -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/web/package.json packages/web/tsconfig.json packages/web/next.config.js packages/web/postcss.config.js packages/web/tailwind.config.ts ./packages/web/

RUN pnpm install --frozen-lockfile

COPY packages/shared/src ./packages/shared/src
COPY packages/web/src ./packages/web/src

RUN pnpm --filter @kiro-scheduler/shared build

EXPOSE 3000
CMD ["pnpm", "--filter", "@kiro-scheduler/web", "dev"]
